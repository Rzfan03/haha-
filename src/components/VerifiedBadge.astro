---
import { Icon } from "astro-icon/components";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={["inline-flex shrink-0 items-center justify-center", className ?? "size-4"]} title="Akun terverifikasi" aria-label="Terverifikasi">
  <Icon name="lucide:badge-check" class="size-full text-brand" />
</span>
