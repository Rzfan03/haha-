---
import { Icon } from "astro-icon/components";
import type { AuthUser } from "../lib/auth";

interface Props {
  user: AuthUser | null;
}

const { user } = Astro.props;
const pathname = Astro.url.pathname;
const isHome = pathname === "/";
const isBookmarks = pathname === "/bookmarks";
---

<nav
  class="fixed inset-x-0 bottom-0 z-[999] border-t border-neutral bg-white/95 backdrop-blur lg:hidden"
  aria-label="Navigasi utama"
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  <div class="mx-auto grid max-w-md grid-cols-3 items-center px-4 pt-1.5 pb-1">
    <a
      href="/"
      class:list={[
        "flex flex-col items-center gap-0.5 rounded-md py-1.5 transition-colors",
        isHome ? "text-brand" : "text-ink-soft hover:text-ink",
      ]}
      aria-current={isHome ? "page" : undefined}
    >
      <Icon name="lucide:home" class="size-6" />
      <span class="text-[11px] font-bold leading-none">Beranda</span>
    </a>

    <div class="flex justify-center">
      {user ? (
        <button
          type="button"
          class="upload-trigger -mt-6 flex size-14 items-center justify-center rounded-full bg-brand text-white shadow-floating ring-4 ring-white transition-transform duration-200 hover:scale-105 active:scale-95"
          aria-label="Upload meme"
        >
          <Icon name="lucide:plus" class="size-7" />
        </button>
      ) : (
        <a
          href="/login"
          class="-mt-6 flex size-14 items-center justify-center rounded-full bg-brand text-white shadow-floating ring-4 ring-white transition-transform duration-200 hover:scale-105 active:scale-95"
          aria-label="Upload meme"
        >
          <Icon name="lucide:plus" class="size-7" />
        </a>
      )}
    </div>

    <a
      href="/bookmarks"
      class:list={[
        "flex flex-col items-center gap-0.5 rounded-md py-1.5 transition-colors",
        isBookmarks ? "text-brand" : "text-ink-soft hover:text-ink",
      ]}
      aria-current={isBookmarks ? "page" : undefined}
    >
      <Icon name="lucide:bookmark" class="size-6" />
      <span class="text-[11px] font-bold leading-none">Bookmark</span>
    </a>
  </div>
</nav>
