---
import { Icon } from "astro-icon/components";
import VerifiedBadge from "./VerifiedBadge.astro";
import type { AuthUser } from "../lib/auth";

interface Props {
  user: AuthUser | null;
}

const { user } = Astro.props;
---

<header class="sticky top-0 z-[999] bg-white shadow-[0_1px_0_rgba(0,0,0,0.06)]">
  <div class="flex items-center gap-2 px-4 py-3 sm:gap-3 sm:px-6">
    <a href="/" class="flex h-12 shrink-0 items-center pr-1 lg:hidden" aria-label="HAHA!">
      <span class="font-display text-3xl font-semibold tracking-tight text-ink">
        Haha<span class="text-brand">!</span>
      </span>
    </a>

    <form action="/search" class="flex h-12 flex-1 items-center gap-2 rounded-md bg-offwhite px-4 focus-within:bg-white focus-within:ring-2 focus-within:ring-brand/60">
      <Icon name="lucide:search" class="size-5 shrink-0 text-ink-soft" />
      <input
        type="search"
        name="q"
        placeholder="Cari meme lucu..."
        class="h-full w-full bg-transparent text-[16px] text-ink outline-none placeholder:text-ink-soft focus:outline-none focus-visible:outline-none"
        aria-label="Cari meme"
      />
    </form>

    {user ? (
      <a
        href={`/user/${user.id}`}
        class="flex h-12 shrink-0 items-center gap-2 rounded-md bg-neutral/30 px-2 transition-colors hover:bg-neutral"
        title={user.display_name}
      >
        <span class="flex size-9 items-center justify-center rounded-md bg-brand text-[13px] font-bold text-white">
          {user.avatar_url ? (
            <img src={user.avatar_url} alt="" class="size-full rounded-md object-cover" />
          ) : (
            user.display_name.charAt(0).toUpperCase()
          )}
        </span>
        <span class="flex shrink-0 items-center gap-1 text-[13px] font-bold text-ink">
          <span class="max-w-[64px] truncate sm:max-w-none">{user.display_name}</span>
          {user.is_verified && <VerifiedBadge class="size-3.5" />}
        </span>
      </a>
    ) : (
      <a
        href="/login"
        class="flex h-12 shrink-0 items-center gap-2 rounded-md bg-brand px-5 font-display text-[14px] font-medium text-white transition-all duration-200 hover:bg-brand-hover active:scale-[0.97]"
      >
        <Icon name="lucide:log-in" class="size-4" />
        Masuk
      </a>
    )}
  </div>
</header>
