---
import { Icon } from "astro-icon/components";
import type { Category } from "../lib/types";
import type { AuthUser } from "../lib/auth";

interface Props {
  categories: Category[];
  user: AuthUser | null;
}

const { categories, user } = Astro.props;
const pathname = Astro.url.pathname;
const isHome = pathname === "/";
const isBookmarks = pathname === "/bookmarks";
const isActiveCategory = (slug: string) => pathname === `/category/${slug}`;
---

<aside
  class="hidden border-r border-neutral bg-white lg:sticky lg:top-0 lg:block lg:h-screen lg:w-[264px] lg:shrink-0 lg:self-start lg:overflow-y-auto"
>
  <div class="flex h-full flex-col px-4 py-5">
    <a href="/" class="flex h-12 items-center px-2" aria-label="HAHA!">
      <span class="font-display text-3xl font-semibold tracking-tight text-ink">Haha<span class="text-brand">!</span></span>
    </a>

    <nav class="mt-6 space-y-1" aria-label="Menu utama">
      <a
        href="/"
        class:list={[
          "flex h-11 items-center gap-2.5 rounded-md px-3 text-[14px] font-bold transition-colors",
          isHome ? "bg-brand-soft text-brand" : "text-ink hover:bg-neutral",
        ]}
      >
        <Icon name="lucide:home" class="size-5" />
        Beranda
      </a>
      <a
        href="/bookmarks"
        class:list={[
          "flex h-11 items-center gap-2.5 rounded-md px-3 text-[14px] font-bold transition-colors",
          isBookmarks ? "bg-brand-soft text-brand" : "text-ink hover:bg-neutral",
        ]}
      >
        <Icon name="lucide:bookmark" class="size-5" />
        Meme Tersimpan
      </a>
    </nav>

    <p class="mt-6 px-3 text-[11px] font-bold uppercase tracking-wide text-ink-soft">Kategori</p>
    <nav class="mt-2 space-y-1" aria-label="Kategori">
      {categories.map((c) => (
        <a
          href={`/category/${c.slug}`}
          class:list={[
            "flex h-10 items-center gap-2 rounded-md px-3 text-[14px] font-bold transition-colors",
            isActiveCategory(c.slug) ? "bg-brand-soft text-brand" : "text-ink hover:bg-neutral",
          ]}
        >
          <span class="text-[15px] leading-none">{c.emoji}</span>
          <span class="truncate">{c.name}</span>
        </a>
      ))}
    </nav>

    <div class="mt-auto space-y-3 pt-6">
      {user ? (
        <>
          <button
            class="upload-trigger flex h-12 w-full items-center justify-center gap-2 rounded-md bg-brand font-display text-[14px] font-medium text-white transition-all duration-200 hover:bg-brand-hover active:scale-[0.98]"
          >
            <Icon name="lucide:upload" class="size-4" />
            Upload Meme
          </button>
          <form method="post" action="/api/auth/logout">
            <button
              type="submit"
              class="flex h-11 w-full items-center justify-center gap-2 rounded-md text-[13px] font-bold text-ink-soft transition-colors hover:bg-neutral hover:text-ink"
            >
              <Icon name="lucide:log-out" class="size-4" />
              Keluar
            </button>
          </form>
        </>
      ) : (
        <>
          <a
            href="/login"
            class="flex h-12 w-full items-center justify-center gap-2 rounded-md bg-brand font-display text-[14px] font-medium text-white transition-all duration-200 hover:bg-brand-hover"
          >
            <Icon name="lucide:log-in" class="size-4" />
            Masuk
          </a>
          <p class="text-center text-[11px] text-ink-soft">Login untuk upload & berinteraksi</p>
        </>
      )}
    </div>
  </div>
</aside>
