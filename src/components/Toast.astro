<div id="toast-root" class="pointer-events-none fixed bottom-6 left-1/2 z-[1100] -translate-x-1/2 space-y-2" aria-live="polite"></div>

<script>
  const root = document.getElementById("toast-root");

  const ICONS = {
    success:
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 text-[#4ade80]"><path d="M20 6 9 17l-5-5"/></svg>',
    error:
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 text-[#f87171]"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>',
  };

  window.addEventListener("haha:toast", (e: Event) => {
    const { message, type = "success" } = (e as CustomEvent).detail;
    const key = type === "error" ? "error" : "success";
    const el = document.createElement("div");
    el.className =
      "pointer-events-auto flex items-center gap-2 rounded-md bg-white px-5 py-3 text-[14px] text-ink shadow-modal animate-scale-in";
    el.innerHTML = `${ICONS[key]}<span></span>`;
    el.querySelector("span")!.textContent = message;
    root!.appendChild(el);
    setTimeout(() => {
      el.style.opacity = "0";
      el.style.transition = "opacity 0.3s";
      setTimeout(() => el.remove(), 300);
    }, 3000);
  });
</script>
