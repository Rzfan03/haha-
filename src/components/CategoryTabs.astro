---
import { getCategories } from "../lib/categories";

const categories = await getCategories();
const pathname = Astro.url.pathname;
const isHome = pathname === "/";
const isActiveCategory = (slug: string) => pathname === `/category/${slug}`;
const isFeedPage = isHome || pathname.startsWith("/category/");
---

<!-- Mobile: strip kategori selalu tampil (scroll horizontal) -->
<nav
  class="scrollbar-hide sticky top-[72px] z-[999] -mx-4 mb-6 flex gap-2 overflow-x-auto border-b border-neutral bg-offwhite/95 px-4 py-3 backdrop-blur lg:hidden"
  aria-label="Kategori meme"
>
  <a
    href="/"
    class:list={[
      "flex h-10 shrink-0 items-center gap-1.5 rounded-md px-3 text-[13px] font-bold transition-colors duration-200",
      isHome ? "bg-brand text-white shadow-floating" : "bg-white text-ink shadow-raised hover:bg-neutral",
    ]}
  >
    Semua
  </a>
  {categories.map((c) => (
    <a
      href={`/category/${c.slug}`}
      class:list={[
        "flex h-10 shrink-0 items-center gap-1.5 rounded-md px-3 text-[13px] font-bold transition-colors duration-200",
        isActiveCategory(c.slug)
          ? "bg-brand text-white shadow-floating"
          : "bg-white text-ink shadow-raised hover:bg-neutral",
      ]}
    >
      <span class="text-[15px] leading-none">{c.emoji}</span>
      {c.name}
    </a>
  ))}
</nav>

<!-- Desktop: hanya di halaman feed (karena sidebar sudah ada kategori) -->
{isFeedPage && (
  <nav
    class="scrollbar-hide sticky top-[72px] z-[999] -mx-4 mb-6 hidden gap-2 overflow-x-auto border-b border-neutral bg-offwhite/95 px-4 py-3 backdrop-blur lg:flex"
    aria-label="Kategori meme"
  >
    <a
      href="/"
      class:list={[
        "flex h-10 shrink-0 items-center gap-1.5 rounded-md px-4 text-[13px] font-bold transition-colors duration-200",
        isHome ? "bg-brand text-white shadow-floating" : "bg-white text-ink shadow-raised hover:bg-neutral",
      ]}
    >
      Semua
    </a>
    {categories.map((c) => (
      <a
        href={`/category/${c.slug}`}
        class:list={[
          "flex h-10 shrink-0 items-center gap-1.5 rounded-md px-4 text-[13px] font-bold transition-colors duration-200",
          isActiveCategory(c.slug)
            ? "bg-brand text-white shadow-floating"
            : "bg-white text-ink shadow-raised hover:bg-neutral",
        ]}
      >
        <span class="text-[15px] leading-none">{c.emoji}</span>
        {c.name}
      </a>
    ))}
  </nav>
)}
