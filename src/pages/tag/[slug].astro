---
import Layout from "../../layouts/Layout.astro";
import FeedSection from "../../components/FeedSection.astro";

const { slug } = Astro.params;
const tag = decodeURIComponent(slug ?? "");
---

<Layout title={`#${tag} — HAHA!`} description={`Meme bertag ${tag}`}>
  <section class="mb-8 py-6">
    <div class="mb-2 inline-flex items-center gap-2 rounded-md bg-brand px-4 py-2 text-[12px] font-bold text-white shadow-raised">
      #{tag}
    </div>
    <h1 class="font-display text-[30px] font-semibold text-ink">Meme tag #{tag}</h1>
    <p class="text-[12px] text-ink-soft"><span id="tag-count">…</span> meme ditemukan</p>
  </section>
  <FeedSection
    url={`/api/posts?tag=${encodeURIComponent(tag)}`}
    countEl="#tag-count"
    emptyTitle={`Tidak ada meme dengan tag #${tag}`}
    emptySub="Coba tag lain, atau upload meme dengan tag ini."
    emptyIcon="lucide:tag"
  />
</Layout>
