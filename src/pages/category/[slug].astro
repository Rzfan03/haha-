---
import Layout from "../../layouts/Layout.astro";
import FeedSection from "../../components/FeedSection.astro";
import { Icon } from "astro-icon/components";
import { supabase } from "../../lib/supabase";
import type { Category } from "../../lib/types";

const { slug } = Astro.params;
const { data: category } = await supabase
  .from("categories")
  .select("*")
  .eq("slug", slug)
  .single();
const cat = (category as Category) ?? null;
---

<Layout title={cat ? `${cat.name} — HAHA!` : "Kategori tidak ditemukan"}>
  {cat ? (
    <>
      <section class="mb-8 flex items-center gap-4 py-6">
        <span class="flex size-16 items-center justify-center rounded-md bg-white text-4xl shadow-raised">{cat.emoji}</span>
        <div>
          <h1 class="font-display text-[30px] font-semibold text-ink">{cat.name}</h1>
          <p class="text-[12px] text-ink-soft"><span id="cat-count">…</span> meme</p>
        </div>
      </section>
      <FeedSection
        url={`/api/posts?category=${cat.slug}`}
        countEl="#cat-count"
        emptyTitle={`Belum ada meme di kategori ${cat.name}`}
        emptySub="Jadi orang pertama yang upload di kategori ini!"
        emptyIcon="lucide:inbox"
      />
    </>
  ) : (
    <div class="flex flex-col items-center gap-4 py-24 text-center">
      <span class="flex size-16 items-center justify-center rounded-md bg-white shadow-raised">
        <Icon name="lucide:search-x" class="size-8 text-ink-soft" />
      </span>
      <p class="text-[16px] font-bold text-ink">Kategori tidak ditemukan</p>
      <a href="/" class="text-[12px] font-bold text-brand hover:underline">Kembali ke beranda</a>
    </div>
  )}
</Layout>
