---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";

const user = Astro.locals.user;
if (!user) return Astro.redirect(`/login?next=${encodeURIComponent("/account")}`);
---

<Layout title="Edit Profil — HAHA!">
  <div class="mx-auto max-w-2xl">
    <a href={`/user/${user.id}`} class="mb-4 inline-flex items-center gap-1.5 text-[13px] font-bold text-ink-soft transition-colors hover:text-brand">
      <Icon name="lucide:arrow-left" class="size-4" />
      Kembali ke profil
    </a>

    <h1 class="mb-6 font-display text-[24px] font-semibold text-ink">Edit Profil</h1>

    <form id="account-form" class="isolate overflow-hidden rounded-md bg-white shadow-raised">
      <div class="relative -z-10 h-36 bg-brand/15 sm:h-44">
        {user.banner_url && <img id="banner-preview" src={user.banner_url} alt="" class="h-full w-full object-cover" />}
        <label
          class="absolute bottom-3 right-3 flex h-10 cursor-pointer items-center gap-1.5 rounded-md bg-ink/60 px-4 text-[12px] font-bold text-white backdrop-blur transition-colors hover:bg-ink/80"
          for="banner-input"
        >
          <Icon name="lucide:image" class="size-4" />
          Ganti banner
        </label>
        <input id="banner-input" name="banner" type="file" accept="image/jpeg,image/png,image/gif,image/webp" class="hidden" />
        <p class="mt-2 text-right text-[11px] text-ink-soft">Banner — maksimal 5MB</p>
      </div>

      <div class="px-6 pb-6">
        <div class="-mt-8 flex items-end gap-4">
          <span id="avatar-wrap" class="relative z-10 flex size-20 shrink-0 items-center justify-center rounded-md bg-brand text-[30px] font-bold text-white shadow-floating ring-4 ring-white">
            {user.avatar_url ? <img id="avatar-preview" src={user.avatar_url} alt="" class="size-full rounded-md object-cover" /> : user.display_name.charAt(0).toUpperCase()}
          </span>
          <label class="mb-1 flex h-10 cursor-pointer items-center gap-1.5 rounded-md bg-offwhite px-4 text-[12px] font-bold text-ink transition-colors hover:bg-neutral" for="avatar-input">
            <Icon name="lucide:camera" class="size-4" />
            Ganti foto
          </label>
          <input id="avatar-input" name="avatar" type="file" accept="image/jpeg,image/png,image/gif,image/webp" class="hidden" />
        <p class="mt-2 text-[11px] text-ink-soft">Foto profil — maksimal 2MB</p>
        </div>

        <div class="mt-6 flex flex-col gap-4">
          <div>
            <label for="account-name" class="mb-1.5 block text-[13px] font-bold text-ink">Nama tampilan</label>
            <input
              id="account-name"
              name="display_name"
              type="text"
              maxlength="30"
              value={user.display_name}
              class="w-full rounded-md border border-[#919190] bg-white px-4 py-3 text-[14px] text-ink outline-none transition-all focus:border-brand focus:ring-2 focus:ring-brand/60"
            />
          </div>
          <div>
            <label for="account-bio" class="mb-1.5 block text-[13px] font-bold text-ink">Bio</label>
            <textarea
              id="account-bio"
              name="bio"
              rows="3"
              maxlength="160"
              placeholder="Ceritakan sedikit tentang dirimu..."
              class="w-full resize-none rounded-md border border-[#919190] bg-white px-4 py-3 text-[14px] text-ink outline-none transition-all placeholder:text-ink-soft focus:border-brand focus:ring-2 focus:ring-brand/60"
            >{user.bio ?? ""}</textarea>
            <p class="mt-1 text-right text-[12px] text-ink-soft"><span id="bio-counter">{(user.bio ?? "").length}</span>/160</p>
          </div>
          <div>
            <label class="mb-1.5 block text-[13px] font-bold text-ink">Email</label>
            <input type="email" value={user.email} disabled class="w-full cursor-not-allowed rounded-md border border-neutral bg-offwhite px-4 py-3 text-[14px] text-ink-soft" />
          </div>

          <p id="account-error" role="alert" class="hidden items-center gap-1.5 rounded-md bg-error/10 px-3 py-2.5 text-[13px] font-bold text-error"></p>

          <div class="flex justify-end">
            <button
              type="submit"
              class="flex h-12 items-center gap-2 rounded-md bg-brand px-8 font-display text-[14px] font-medium text-white transition-all duration-200 hover:bg-brand-hover active:scale-[0.98] disabled:cursor-not-allowed disabled:bg-neutral disabled:text-ink-soft"
            >
              <Icon id="account-spinner" name="lucide:loader-2" class="hidden size-4 animate-spin" />
              Simpan perubahan
            </button>
          </div>
        </div>
      </div>
    </form>
  </div>
</Layout>

<script>
  const form = document.getElementById("account-form") as HTMLFormElement;
  const errorEl = document.getElementById("account-error") as HTMLParagraphElement;
  const spinner = document.getElementById("account-spinner") as HTMLElement;
  const avatarInput = document.getElementById("avatar-input") as HTMLInputElement;
  const bannerInput = document.getElementById("banner-input") as HTMLInputElement;
  const avatarPreview = document.getElementById("avatar-preview") as HTMLImageElement | null;
  const bannerPreview = document.getElementById("banner-preview") as HTMLImageElement | null;
  const avatarWrap = document.getElementById("avatar-wrap") as HTMLElement;
  const bioInput = document.getElementById("account-bio") as HTMLTextAreaElement;
  const bioCounter = document.getElementById("bio-counter") as HTMLElement;

  function showError(msg: string) {
    errorEl.textContent = msg;
    errorEl.classList.remove("hidden");
    errorEl.classList.add("flex");
  }

  function previewImage(input: HTMLInputElement, img: HTMLImageElement | null) {
    const file = input.files?.[0];
    if (file && img) img.src = URL.createObjectURL(file);
  }

  const MAX_AVATAR = 2 * 1024 * 1024;
  const MAX_BANNER = 5 * 1024 * 1024;

  function validateSize(input: HTMLInputElement, maxBytes: number, label: string): boolean {
    const file = input.files?.[0];
    if (file && file.size > maxBytes) {
      showError(`${label} tidak boleh lebih dari ${Math.floor(maxBytes / 1024 / 1024)}MB`);
      input.value = "";
      return false;
    }
    return true;
  }

  avatarInput?.addEventListener("change", () => {
    if (!validateSize(avatarInput, MAX_AVATAR, "Avatar")) return;
    const file = avatarInput.files?.[0];
    if (file) {
      if (avatarPreview) {
        avatarPreview.src = URL.createObjectURL(file);
      } else {
        const img = document.createElement("img");
        img.id = "avatar-preview";
        img.src = URL.createObjectURL(file);
        img.alt = "";
        img.className = "size-full rounded-md object-cover";
        avatarWrap!.appendChild(img);
      }
    }
  });
  bannerInput?.addEventListener("change", () => {
    if (!validateSize(bannerInput, MAX_BANNER, "Banner")) return;
    previewImage(bannerInput, bannerPreview);
  });
  bioInput?.addEventListener("input", () => {
    bioCounter.textContent = String(bioInput.value.length);
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.classList.add("hidden");
    errorEl.classList.remove("flex");

    if (!validateSize(avatarInput, MAX_AVATAR, "Avatar") || !validateSize(bannerInput, MAX_BANNER, "Banner")) return;

    const btn = form.querySelector("button[type=submit]") as HTMLButtonElement;
    btn.disabled = true;
    spinner.classList.remove("hidden");
    try {
      const fd = new FormData(form);
      const res = await fetch("/api/account", { method: "POST", body: fd });
      const raw = await res.text();
      let data: Record<string, unknown> = {};
      try {
        data = raw ? JSON.parse(raw) : {};
      } catch {
        data = { error: raw || `HTTP ${res.status}` };
      }
      if (!res.ok) throw new Error(String(data.error || `Gagal menyimpan (${res.status})`));
      const savedUser = data.user as { id: string } | undefined;
      if (!savedUser?.id) throw new Error("Respon tidak valid");
      window.dispatchEvent(new CustomEvent("haha:toast", { detail: { message: "Profil berhasil disimpan! ✅" } }));
      window.location.href = `/user/${savedUser.id}`;
    } catch (err) {
      showError((err as Error).message);
      btn.disabled = false;
      spinner.classList.add("hidden");
    }
  });
</script>
