---
import Layout from "../../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { getUserById } from "../../../lib/auth";

const { id } = Astro.params;
const user = await getUserById(id ?? "");
---

<Layout title={user ? `Pengikut ${user.display_name} — HAHA!` : "Pengikut"} description={`Pengikut ${user?.display_name ?? ""}`}>
  {user ? (
    <>
      <a href={`/user/${user.id}`} class="mb-4 inline-flex items-center gap-1.5 text-[13px] font-bold text-ink-soft transition-colors hover:text-brand">
        <Icon name="lucide:arrow-left" class="size-4" />
        Kembali ke profil
      </a>
      <h1 class="mb-6 font-display text-[22px] font-semibold text-ink">Pengikut {user.display_name}</h1>

      <ul id="user-list" class="space-y-3" data-id={user.id} data-kind="followers">
        {
          Array.from({ length: 8 }).map(() => (
            <li class="flex items-center gap-3 rounded-md bg-white p-4 shadow-raised">
              <span class="skeleton size-11 shrink-0 rounded-md"></span>
              <span class="skeleton h-4 w-40 rounded-md"></span>
              <span class="skeleton ml-auto h-10 w-24 rounded-md"></span>
            </li>
          ))
        }
      </ul>

      <div id="user-empty" class="hidden flex-col items-center gap-3 rounded-md bg-white py-16 text-center shadow-raised">
        <Icon name="lucide:users" class="size-8 text-ink-soft" />
        <p class="text-[14px] font-bold text-ink">Belum ada pengikut</p>
      </div>
    </>
  ) : (
    <p class="py-24 text-center text-[14px] text-ink-soft">Pengguna tidak ditemukan.</p>
  )}
</Layout>

<script>
  import { initUserList } from "../../../scripts/initUserList";
  const list = document.getElementById("user-list") as HTMLElement | null;
  if (list?.dataset.id && list.dataset.kind) initUserList(list.dataset.id, list.dataset.kind as "followers" | "following");
</script>
