---
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/PostCard.astro";
import VerifiedBadge from "../../components/VerifiedBadge.astro";
import { Icon } from "astro-icon/components";
import { supabase } from "../../lib/supabase";
import { getUserById } from "../../lib/auth";
import type { Post } from "../../lib/types";

const { id } = Astro.params;
const user = await getUserById(id ?? "");
const viewer = Astro.locals.user;

let posts: Post[] = [];
let followers = 0;
let following = 0;
let isFollowing = false;

if (user) {
  const db = supabase;
  const [postsRes, followersRes, followingRes] = await Promise.all([
    db.from("posts").select("*, categories(name, slug, emoji)").eq("user_id", user.id).order("created_at", { ascending: false }).limit(24),
    db.from("follows").select("id", { count: "exact", head: true }).eq("following_id", user.id),
    db.from("follows").select("id", { count: "exact", head: true }).eq("follower_id", user.id),
  ]);
  posts = (postsRes.data as Post[]) ?? [];
  followers = followersRes.count ?? 0;
  following = followingRes.count ?? 0;

  if (viewer && viewer.id !== user.id) {
    const { data: rel } = await supabase
      .from("follows")
      .select("follower_id")
      .eq("follower_id", viewer.id)
      .eq("following_id", user.id)
      .maybeSingle();
    isFollowing = !!rel;
  }
}

const isOwn = viewer?.id === user?.id;
---

<Layout title={user ? `${user.display_name} — HAHA!` : "Profil tidak ditemukan"}>
  {user ? (
    <>
      <div class="isolate overflow-hidden rounded-md bg-white shadow-raised">
        <div class="relative -z-10 h-40 bg-brand/15 sm:h-52">
          {user.banner_url && <img src={user.banner_url} alt="" class="h-full w-full object-cover" />}
        </div>
        <div class="px-6 pb-6">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div class="flex items-end gap-3 sm:gap-4">
              <span class="relative z-10 -mt-6 flex size-14 shrink-0 items-center justify-center rounded-md bg-brand text-[20px] font-bold text-white shadow-floating ring-4 ring-white sm:-mt-8 sm:size-20 sm:text-[30px]">
                {user.avatar_url ? <img src={user.avatar_url} alt="" class="size-full rounded-md object-cover" /> : user.display_name.charAt(0).toUpperCase()}
              </span>
              <div class="min-w-0 pb-1">
                <h1 class="flex items-center gap-1.5 font-display text-[17px] font-semibold text-ink sm:text-[22px]">
                  <span class="truncate">{user.display_name}</span>
                  {user.is_verified && <VerifiedBadge class="size-5" />}
                </h1>
                <p class="flex items-center gap-1.5 text-[12px] text-ink-soft">
                  <Icon name="lucide:calendar" class="size-3.5" />
                  Bergabung {new Date(user.created_at).toLocaleDateString("id-ID", { month: "long", year: "numeric" })}
                </p>
              </div>
            </div>

            {isOwn ? (
              <a
                href="/account"
                class="hidden h-11 items-center gap-2 rounded-md bg-offwhite px-5 text-[13px] font-bold text-ink transition-colors hover:bg-neutral sm:flex"
              >
                <Icon name="lucide:settings" class="size-4" />
                Edit profil
              </a>
            ) : viewer?.is_admin ? (
              <button
                id="admin-verify-btn"
                data-user-id={user.id}
                data-verified={String(user.is_verified)}
                class="flex h-11 w-full items-center justify-center gap-2 rounded-md bg-offwhite px-5 text-[13px] font-bold text-ink transition-colors hover:bg-neutral sm:w-auto"
              >
                <Icon name="lucide:badge-check" class="size-4 text-brand" />
                {user.is_verified ? "Cabut verifikasi" : "Verifikasi akun"}
              </button>
            ) : viewer ? (
              <button
                id="follow-btn"
                data-user-id={user.id}
                data-following={String(isFollowing)}
                class:list={[
                  "flex h-11 w-full items-center justify-center gap-2 rounded-md px-6 text-[13px] font-bold transition-all duration-200 sm:w-auto",
                  isFollowing ? "bg-offwhite text-ink hover:bg-neutral" : "bg-brand text-white hover:bg-brand-hover",
                ]}
              >
                {isFollowing ? "Mengikuti" : "Ikuti"}
              </button>
            ) : null}
          </div>

          {user.bio && <p class="mt-4 whitespace-pre-line text-[14px] text-ink">{user.bio}</p>}

          <div class="mt-5 flex gap-6 text-[13px]">
            <span class="text-ink"><b class="font-bold text-ink">{posts.length}</b> <span class="text-ink-soft">meme</span></span>
            <a href={`/user/${user.id}/followers`} class="text-ink transition-colors hover:text-brand"><b class="font-bold text-ink">{followers}</b> <span class="text-ink-soft">pengikut</span></a>
            <a href={`/user/${user.id}/following`} class="text-ink transition-colors hover:text-brand"><b class="font-bold text-ink">{following}</b> <span class="text-ink-soft">mengikuti</span></a>
          </div>

          {isOwn && (
            <a
              href="/account"
              class="mt-4 flex h-11 items-center justify-center gap-2 rounded-md bg-offwhite text-[13px] font-bold text-ink transition-colors hover:bg-neutral sm:hidden"
            >
              <Icon name="lucide:settings" class="size-4" />
              Edit profil
            </a>
          )}
        </div>
      </div>

      <section class="mt-8">
        <h2 class="mb-4 font-display text-[18px] font-semibold text-ink">Meme {user.display_name}</h2>
        {posts.length > 0 ? (
          <div class="columns-2 gap-3 sm:gap-4 lg:columns-3 xl:columns-4">
            {posts.map((p) => <PostCard post={p} />)}
          </div>
        ) : (
          <div class="flex flex-col items-center gap-3 rounded-md bg-white py-16 text-center shadow-raised">
            <Icon name="lucide:image-off" class="size-8 text-ink-soft" />
            <p class="text-[14px] font-bold text-ink">{isOwn ? "Kamu belum upload meme" : "Belum ada meme nih"}</p>
          </div>
        )}
      </section>
    </>
  ) : (
    <div class="flex flex-col items-center gap-4 py-24 text-center">
      <span class="flex size-16 items-center justify-center rounded-md bg-white shadow-raised">
        <Icon name="lucide:user-x" class="size-8 text-ink-soft" />
      </span>
      <p class="text-[16px] font-bold text-ink">Pengguna tidak ditemukan</p>
      <a href="/" class="text-[12px] font-bold text-brand hover:underline">Kembali ke beranda</a>
    </div>
  )}
</Layout>

<script>
  const btn = document.getElementById("follow-btn") as HTMLButtonElement | null;
  if (btn) {
    const b = btn;
    const userId = b.dataset.userId!;
    let following = b.dataset.following === "true";

    function paint() {
      b.classList.toggle("bg-brand", !following);
      b.classList.toggle("text-white", !following);
      b.classList.toggle("hover:bg-brand-hover", !following);
      b.classList.toggle("bg-offwhite", following);
      b.classList.toggle("text-ink", following);
      b.classList.toggle("hover:bg-neutral", following);
      b.textContent = following ? "Mengikuti" : "Ikuti";
    }

    b.addEventListener("click", async () => {
      b.disabled = true;
      const next = !following;
      following = next;
      paint();
      try {
        const res = await fetch("/api/follow", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ target_id: userId }),
        });
        if (res.status === 401) {
          window.location.href = `/login?next=${encodeURIComponent(window.location.pathname)}`;
          return;
        }
        if (!res.ok) throw new Error();
      } catch {
        following = !next;
        paint();
      } finally {
        b.disabled = false;
      }
    });
  }

  const adminBtn = document.getElementById("admin-verify-btn") as HTMLButtonElement | null;
  if (adminBtn) {
    const b = adminBtn;
    const userId = b.dataset.userId!;
    let verified = b.dataset.verified === "true";

    b.addEventListener("click", async () => {
      b.disabled = true;
      const next = !verified;
      verified = next;
      b.innerHTML = next
        ? `<span class="inline-flex size-4 items-center justify-center"><svg class="size-4 animate-spin" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-opacity="0.25" stroke-width="4"/><path d="M4 12a8 8 0 018-8" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg></span> Cabut verifikasi`
        : `<span class="inline-flex size-4 items-center justify-center"><svg class="size-4 animate-spin" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-opacity="0.25" stroke-width="4"/><path d="M4 12a8 8 0 018-8" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg></span> Verifikasi akun`;
      try {
        const res = await fetch("/api/admin/verify", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ user_id: userId, verified: next }),
        });
        if (!res.ok) throw new Error();
        b.innerHTML = next
          ? `<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg> Cabut verifikasi`
          : `<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg> Verifikasi akun`;
        window.dispatchEvent(new CustomEvent("haha:toast", { detail: { message: next ? "Akun berhasil diverifikasi! ✅" : "Verifikasi dicabut" } }));
        window.location.reload();
      } catch {
        verified = !next;
        window.dispatchEvent(new CustomEvent("haha:toast", { detail: { message: "Gagal mengubah verifikasi", type: "error" } }));
      } finally {
        b.disabled = false;
      }
    });
  }
</script>
