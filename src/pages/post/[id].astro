---
import Layout from "../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { serviceClient } from "../../lib/auth";

const { id } = Astro.params;
const { data: metaPost } = await serviceClient()
  .from("posts")
  .select("title, description, image_url")
  .eq("id", id)
  .maybeSingle();
---

<Layout
  title={metaPost?.title ? `${metaPost.title} — HAHA!` : "Meme — HAHA!"}
  description={metaPost?.description ?? undefined}
  image={metaPost?.image_url ?? undefined}
>
  <div class="mx-auto max-w-3xl">
    <a
      href="/"
      class="mb-4 inline-flex items-center gap-1.5 text-[13px] font-bold text-ink-soft transition-colors hover:text-brand"
    >
      <Icon name="lucide:arrow-left" class="size-4" />
      Kembali
    </a>

    <div id="post-root" data-post-id={id}>
      <div id="post-skeleton" aria-hidden="true">
        <div class="skeleton aspect-[4/3] w-full rounded-md"></div>
        <div class="mt-4 grid gap-3 sm:grid-cols-[1fr_auto]">
          <div class="skeleton h-20 rounded-md"></div>
          <div class="skeleton hidden h-12 w-36 rounded-md sm:block"></div>
        </div>
        <div class="mt-4 space-y-3">
          <div class="skeleton h-6 w-40 rounded-md"></div>
          <div class="skeleton h-9 w-full max-w-lg rounded-md"></div>
          <div class="skeleton h-4 w-3/4 rounded-md"></div>
          <div class="skeleton h-14 w-full rounded-md"></div>
        </div>
        <div class="mt-6 space-y-3">
          <div class="skeleton h-6 w-32 rounded-md"></div>
          <div class="skeleton h-24 rounded-md"></div>
          <div class="skeleton h-24 rounded-md"></div>
        </div>
      </div>
    </div>

    <div id="post-notfound" class="hidden flex-col items-center gap-4 py-24 text-center">
      <span class="flex size-16 items-center justify-center rounded-md bg-white shadow-raised">
        <Icon name="lucide:image-off" class="size-8 text-ink-soft" />
      </span>
      <p class="text-[16px] font-bold text-ink">Meme tidak ditemukan</p>
      <p class="text-[12px] text-ink-soft">Mungkin sudah dihapus atau URL-nya salah.</p>
      <a href="/" class="text-[12px] font-bold text-brand hover:underline">Kembali ke beranda</a>
    </div>
  </div>
</Layout>

<script>
  import { initPost } from "../../scripts/initPost";
  const root = document.getElementById("post-root") as HTMLElement | null;
  if (root?.dataset.postId) initPost(root.dataset.postId);
</script>
